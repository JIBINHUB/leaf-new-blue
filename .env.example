# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Email (existing — enquiry delivery via Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Leaf Creationism <hello@leafcreationism.in>
LEAF_INBOX_EMAIL=leafcreationism@gmail.com
LEAF_EMAIL_LOGO_URL=https://leafcreationism.in/assets/email/leaf-gradient-logo-email.png
LEAF_EMAIL_HERO_URL=https://leafcreationism.in/assets/email/leaf-email-hero.jpg

# ---------------------------------------------------------------------------
# Firebase — asset hosting on Cloud Storage
# ---------------------------------------------------------------------------

# Firebase console -> Storage. Shown at the top, e.g.
#   leaf-creationism.firebasestorage.app
# Used by the upload script only.
FIREBASE_STORAGE_BUCKET=

# Path to the downloaded service account JSON. THIS FILE IS A SECRET —
# it grants write access to your storage. Keep it inside firebase/ which is
# gitignored, and never paste its contents anywhere.
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT=./firebase/service-account.json

# THE SWITCH. Set this and `npm run build` serves every /assets/... file from
# Firebase. Leave it EMPTY and the site serves assets from Vercel exactly as it
# does today. Flip it either way at any time — no code changes needed.
#   https://storage.googleapis.com/<your-bucket-name>
FIREBASE_ASSET_BASE=

# ---------------------------------------------------------------------------
# Firebase — client SDK (only needed if you later add Firestore/Auth in the app)
# Firebase console -> Project settings -> General -> Your apps -> Web app -> Config
# NOTE: the web apiKey is NOT a secret. It is designed to ship in client code
# and is safe in the bundle; access is controlled by security rules, not by it.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
